# Copy to .env or export these variables before `npm start`.
PORT=3000
NODE_ENV=development
# Required when NODE_ENV=production (32+ random characters)
SESSION_SECRET=
# Set to 1 when the app runs behind a reverse proxy / hosting platform (Render, Railway, nginx...)
TRUST_PROXY=
# Simulated trading fee as a fraction (0.001 = 0.1%)
FEE_RATE=0.001
# Market data older than this is treated as stale and trading is paused (milliseconds)
MARKET_STALE_MS=30000
# Optional: turns the learning assistant into a real AI (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
